Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /MotionPlanning1
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Wrist Camera
      Normalize Range: true
      Min Value: 0
      Max Value: 1
      Median window: 5
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /cuboid_pose_bridge/debug_image
      Value: true
    - Class: moveit_rviz_plugin/MotionPlanning
      Name: MotionPlanning
      Move Group Namespace: ""
      Planning Request:
        Interactive Marker Size: 0.1
        Planning Group: arm
      Planned Path:
        Loop Animation: true
        State Display Time: 0.05 s
        Trajectory Topic: display_planned_path
      Planning Scene Topic: monitored_planning_scene
      Robot Description: robot_description
      Scene Geometry:
        Scene Alpha: 1
      Scene Robot:
        Robot Alpha: 0.5
      Value: true
    - Class: rviz_default_plugins/Marker
      Name: PnP Targets
      Namespaces: {}
      Topic:
        Depth: 100
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /pnp_targets
      Value: true
    - Class: rviz_default_plugins/Marker
      Name: Sim Objects
      Namespaces: {}
      Topic:
        Depth: 100
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /pnp_sim_objects
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Frame Timeout: 15
      Marker Scale: 0.15
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Frames:
        All Enabled: false
        base_link:
          Value: true
        camera_link:
          Value: true
        tcp_link:
          Value: true
      Value: false
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base_link
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.8
      Focal Point:
        X: 0.15
        Y: 0.0
        Z: 0.25
      Name: Current View
      Pitch: 0.55
      Target Frame: base_link
      Yaw: 0.9
Window Geometry:
  Displays:
    collapsed: false
  Height: 1016
  Hide Left Dock: false
  Hide Right Dock: false
  MotionPlanning:
    collapsed: false
  MotionPlanning - Trajectory Slider:
    collapsed: false
  QMainWindow State: 
  Views:
    collapsed: false
  Width: 1850
  Wrist Camera:
    collapsed: false
  X: 70
  Y: 27
